{
  "name": "marvo-frontend",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-production-css.mjs",
    "preview": "vite preview --port 5080",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint src e2e playwright.config.ts vite.config.ts --deny-warnings && node scripts/check-dialog-lifecycle.mjs",
    "deadcode": "knip --reporter compact",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run deadcode && npm run format:check",
    "test:e2e": "playwright test",
    "test:e2e:preview": "npm run build && E2E_PREVIEW=1 playwright test e2e/responsive-layout.spec.ts --project=chromium-portrait",
    "test:e2e:webkit": "bash e2e/run-webkit.sh"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@ark-ui/vue": "^5.37.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@opencode-ai/sdk": "1.18.15",
    "@tiptap/core": "^3.25.0",
    "@tiptap/extension-code-block": "^3.25.0",
    "@tiptap/extension-highlight": "^3.25.0",
    "@tiptap/extension-image": "^3.25.0",
    "@tiptap/extension-link": "^3.25.0",
    "@tiptap/extension-placeholder": "^3.25.0",
    "@tiptap/extension-table": "^3.25.0",
    "@tiptap/extension-table-cell": "^3.25.0",
    "@tiptap/extension-table-header": "^3.25.0",
    "@tiptap/extension-table-row": "^3.25.0",
    "@tiptap/extension-task-item": "^3.25.0",
    "@tiptap/extension-task-list": "^3.25.0",
    "@tiptap/extension-text-align": "^3.25.0",
    "@tiptap/starter-kit": "^3.25.0",
    "@tiptap/vue-3": "^3.25.0",
    "dompurify": "^3.4.13",
    "markdown-it": "^14.1.1",
    "node-diff3": "^3.2.1",
    "pinia": "^2.3.0",
    "qrcode.vue": "^3.10.0",
    "sass": "^1.100.0",
    "tiptap-markdown": "^0.9.0",
    "uuid": "^14.0.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.12.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "knip": "^6.32.0",
    "oxlint": "^1.77.0",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "vite": "^8.0.12",
    "vue-tsc": "^3.3.9"
  }
}
