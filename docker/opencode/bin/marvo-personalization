#!/usr/bin/env python3

import argparse
import json
import os
from pathlib import Path
import tempfile
import uuid


RULES_PATH = Path("/workspace/.agent-personalization.json")
MAX_RULES = 256
MAX_RULE_BYTES = 4 * 1024


def normalize_text(value: str) -> str:
    text = value.strip()
    if not text or "\n" in text or "\r" in text or len(text.encode("utf-8")) > MAX_RULE_BYTES:
        raise ValueError("规则必须是非空的单行文本，且不能超过 4 KiB")
    return text


def normalize_id(value: str) -> str:
    try:
        parsed = uuid.UUID(value.strip())
    except (ValueError, AttributeError) as error:
        raise ValueError("规则 ID 无效") from error
    if parsed.version != 4:
        raise ValueError("规则 ID 无效")
    return str(parsed)


def validate_rules(value: object) -> list[dict[str, str]]:
    if not isinstance(value, dict) or set(value) != {"rules"} or not isinstance(value["rules"], list):
        raise ValueError("个性化规则文件格式无效")
    source = value["rules"]
    if len(source) > MAX_RULES:
        raise ValueError("个性化规则数量超过限制")
    result: list[dict[str, str]] = []
    ids: set[str] = set()
    texts: set[str] = set()
    for item in source:
        if not isinstance(item, dict) or set(item) != {"id", "text"}:
            raise ValueError("个性化规则格式无效")
        rule_id = normalize_id(item["id"])
        text = normalize_text(item["text"])
        if rule_id in ids or text in texts:
            raise ValueError("个性化规则存在重复")
        ids.add(rule_id)
        texts.add(text)
        result.append({"id": rule_id, "text": text})
    return result


def read_rules() -> list[dict[str, str]]:
    try:
        info = RULES_PATH.lstat()
    except FileNotFoundError:
        return []
    if not info or RULES_PATH.is_symlink() or not RULES_PATH.is_file():
        raise ValueError("个性化规则文件不是普通文件")
    with RULES_PATH.open("r", encoding="utf-8") as source:
        return validate_rules(json.load(source))


def write_rules(rules: list[dict[str, str]]) -> None:
    validate_rules({"rules": rules})
    if not rules:
        try:
            RULES_PATH.unlink()
        except FileNotFoundError:
            pass
        return

    descriptor, temporary_name = tempfile.mkstemp(prefix=".agent-personalization.", dir=RULES_PATH.parent)
    temporary = Path(temporary_name)
    try:
        os.chmod(temporary, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as output:
            json.dump({"rules": rules}, output, ensure_ascii=False, indent=2)
            output.write("\n")
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, RULES_PATH)
    except Exception:
        try:
            temporary.unlink()
        except FileNotFoundError:
            pass
        raise


def list_rules(_args: argparse.Namespace) -> None:
    rules = read_rules()
    if not rules:
        print("当前没有个性化规则。")
        return
    for rule in rules:
        print(f"{rule['id']} — {rule['text']}")


def add_rule(args: argparse.Namespace) -> None:
    rules = read_rules()
    text = normalize_text(args.text)
    if any(rule["text"] == text for rule in rules):
        print(f"规则已存在：{text}")
        return
    if len(rules) >= MAX_RULES:
        raise ValueError("个性化规则数量已经达到上限")
    rule = {"id": str(uuid.uuid4()), "text": text}
    write_rules([*rules, rule])
    print(f"已添加个性化规则：{text}")


def update_rule(args: argparse.Namespace) -> None:
    rules = read_rules()
    rule_id = normalize_id(args.id)
    text = normalize_text(args.text)
    index = next((index for index, rule in enumerate(rules) if rule["id"] == rule_id), -1)
    if index < 0:
        raise ValueError("没有找到指定的个性化规则")
    if any(candidate != index and rule["text"] == text for candidate, rule in enumerate(rules)):
        raise ValueError("修改后的规则与现有规则重复")
    rules[index] = {"id": rule_id, "text": text}
    write_rules(rules)
    print(f"已更新个性化规则：{text}")


def remove_rule(args: argparse.Namespace) -> None:
    rules = read_rules()
    rule_id = normalize_id(args.id)
    rule = next((rule for rule in rules if rule["id"] == rule_id), None)
    if rule is None:
        raise ValueError("没有找到指定的个性化规则")
    write_rules([candidate for candidate in rules if candidate["id"] != rule_id])
    print(f"已删除个性化规则：{rule['text']}")


def parser() -> argparse.ArgumentParser:
    result = argparse.ArgumentParser(description="管理 Marvo 个性化规则")
    commands = result.add_subparsers(dest="command", required=True)

    list_command = commands.add_parser("list", help="查看规则")
    list_command.set_defaults(handler=list_rules)

    add_command = commands.add_parser("add", help="新增规则")
    add_command.add_argument("--text", required=True)
    add_command.set_defaults(handler=add_rule)

    update_command = commands.add_parser("update", help="更新规则")
    update_command.add_argument("--id", required=True)
    update_command.add_argument("--text", required=True)
    update_command.set_defaults(handler=update_rule)

    remove_command = commands.add_parser("remove", help="删除规则")
    remove_command.add_argument("--id", required=True)
    remove_command.set_defaults(handler=remove_rule)
    return result


def main() -> int:
    try:
        args = parser().parse_args()
        args.handler(args)
        return 0
    except (ValueError, json.JSONDecodeError, OSError) as error:
        print(f"操作失败：{error}", file=os.sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
